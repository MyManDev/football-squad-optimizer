# Project data
#   Small synthetic sample data under data/sample/ is committed on purpose and is
#   reproducible from scripts/generate_sample_data.py. Everything else under data/
#   stays local: third-party historical dumps have unverified licensing and the
#   repository is not a data store.
data/raw/
data/external/
data/interim/
data/processed/

# Captured pre-deadline snapshots of the live season. These hold real third-party
# data, so they stay local for the same reason data/raw/ does: the source permits
# private use and forbids redistribution. Reproducibility comes from the snapshot
# being immutable and checksummed on disk, not from committing it.
data/snapshots/
# The season ledger and projection handoffs derive from those captures (per-player
# rows, prices, projections) and stay local for the same reason; the committed record
# is the generated summary under docs/ (season_ledger_<season>.md).
data/ledger/
data/handoffs/
data/logs/
data/runtime/
# The entry registry lists the members of a real classic league by entry id and team
# name, so it is third-party data about identifiable people and stays local like the
# captures. data/sample/entry_registry_v1.example.json carries the shape, and
# scripts/seed_entry_registry.py rebuilds the real file from a captured standings page.
data/entries/

# Reproducible local experiment outputs (reports are generated, not source data)
artifacts/
# web frontend
web/node_modules/
!web/src/lib/
web/dist/
web/playwright-report/
web/test-results/

# Half-written shadow artifacts. The create-once writer completes and fsyncs a
# sibling temporary before publishing it with a no-overwrite link, and removes it on
# every path; a hard kill can still strand one, and an untracked file beside a report
# makes every later run record a dirty tree.
docs/.*.json.tmp-*
