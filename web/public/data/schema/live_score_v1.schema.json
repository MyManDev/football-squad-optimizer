              "reason": {
                "type": "string"
              },
              "transfer_hit_points": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "bonus_confirmed": {
                "not": {
                  "type": "null"
                }
              },
              "captured_at_utc": {
                "not": {
                  "type": "null"
                }
              },
              "fixtures_finished": {
                "not": {
                  "type": "null"
                }
              },
              "fixtures_total": {
                "not": {
                  "type": "null"
                }
              },
              "named_score": {
                "not": {
                  "type": "null"
                }
              },
              "net_score": {
                "not": {
                  "type": "null"
                }
              },
              "reason": {
                "type": "null"
              },
              "source_snapshot_id": {
                "not": {
                  "type": "null"
                }
              },
              "transfer_hit_points": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "properties": {
        "bonus_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "captured_at_utc": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "decision_snapshot_id": {
          "type": "string"
        },
        "fixtures_finished": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
