{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FPL entry season v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "entry_id", "source_time", "weeks", "chips"],
  "properties": {
    "contract_version": {"const": "fpl_entry_season_v1"},
    "entry_id": {"$ref": "#/$defs/id"},
    "source_time": {"$ref": "#/$defs/sourceTime"},
    "weeks": {"type": "array", "items": {"$ref": "#/$defs/week"}},
    "chips": {"type": "array", "items": {"$ref": "#/$defs/chip"}}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "gameweek": {"type": "integer", "minimum": 1, "maximum": 38},
    "sourceTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "points",
        "total_points",
        "rank",
        "overall_rank",
        "event_transfers",
        "event_transfers_cost",
        "bank",
        "value"
      ],
      "properties": {
        "event": {"$ref": "#/$defs/gameweek"},
        "points": {"type": "integer"},
        "total_points": {"type": "integer"},
        "rank": {"type": ["integer", "null"], "minimum": 0},
        "overall_rank": {"type": ["integer", "null"], "minimum": 0},
        "event_transfers": {"type": "integer", "minimum": 0},
        "event_transfers_cost": {"type": "integer", "minimum": 0},
        "bank": {"type": ["integer", "null"]},
        "value": {"type": ["integer", "null"]}
      }
    },
    "chip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "event"],
      "properties": {
        "name": {"type": "string"},
        "event": {"$ref": "#/$defs/gameweek"}
      }
    }
  }
}
