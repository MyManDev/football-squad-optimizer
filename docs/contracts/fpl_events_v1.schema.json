{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FPL events v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_time", "events"],
  "properties": {
    "contract_version": {"const": "fpl_events_v1"},
    "source_time": {"$ref": "#/$defs/sourceTime"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "sourceTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finished", "data_checked", "average_entry_score", "highest_score"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 38},
        "finished": {"type": "boolean"},
        "data_checked": {"type": "boolean"},
        "average_entry_score": {"type": "integer", "minimum": 0},
        "highest_score": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
