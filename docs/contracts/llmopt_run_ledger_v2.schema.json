{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "runs",
    "jobs",
    "cancelled"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "llmopt_run_ledger_v2"
    },
    "runs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding",
          "capture",
          "window",
          "base",
          "closed",
          "base_cached",
          "requests",
          "reserved"
        ],
        "properties": {
          "binding": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capture": {
            "type": [
              "string",
              "null"
            ]
          },
          "window": {
            "type": "integer",
            "enum": [
              1,
              3
            ]
          },
          "base": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "closed": {
            "type": "boolean"
          },
          "base_cached": {
            "type": "boolean"
          },
          "repair_candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "maxItems": 2,
            "uniqueItems": true
          },
          "requests": {
            "type": "object",
            "maxProperties": 4,
            "propertyNames": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "reserved": {
            "type": "number",
            "minimum": 0,
            "maximum": 488
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit",
          "runs",
          "receipt",
          "legacy_consumer"
        ],
        "properties": {
          "limit": {
            "type": "number",
            "enum": [
              21,
              63,
              122,
              366
            ]
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "legacy_consumer": {
            "type": "boolean"
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "answer_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "finished": {
                "type": "boolean"
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "cp_used": {
                "type": "number",
                "minimum": 0
              },
              "native_reserved": {
                "type": "number",
                "minimum": 0
              },
              "pending": {
                "type": "number",
                "minimum": 0
              },
              "unconfirmed": {
                "type": "number",
                "minimum": 0
              },
              "charged": {
                "type": "number",
                "minimum": 0
              }
            },
            "dependentRequired": {
              "attempt": [
                "finished",
                "calls",
                "cp_used",
                "native_reserved",
                "pending",
                "unconfirmed"
              ],
              "charged": [
                "attempt"
              ]
            }
          }
        }
      }
    },
    "cancelled": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
