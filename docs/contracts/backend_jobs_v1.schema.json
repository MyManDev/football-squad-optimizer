{
  "$id": "https://squadopt.dev/contracts/backend_jobs_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_version": {
      "const": "backend_jobs_v1",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
              "type": "string"
            },
            "message": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "queued",
        "running"
      ],
      "type": "string"
    },
    "updated_at_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "job_id",
    "status",
    "request_fingerprint",
    "cache_key",
    "created_at_utc",
    "updated_at_utc",
    "attempt",
    "idempotency_key",
    "result_ref",
    "error"
  ],
  "title": "SquadOpt advice job record",
  "type": "object"
}
