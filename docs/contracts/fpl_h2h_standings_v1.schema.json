{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FPL head-to-head league standings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "league", "page", "has_next", "source_time", "results"],
  "properties": {
    "contract_version": {"const": "fpl_h2h_standings_v1"},
    "league": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scoring"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": ["string", "null"]},
        "scoring": {"const": "h2h"}
      }
    },
    "page": {"type": "integer", "minimum": 1, "maximum": 1000},
    "has_next": {"type": "boolean"},
    "source_time": {"$ref": "#/$defs/sourceTime"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/standing"}}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sourceTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "entry_name",
        "player_name",
        "rank",
        "rank_sort",
        "last_rank",
        "total",
        "matches_played",
        "matches_won",
        "matches_drawn",
        "matches_lost",
        "points_for"
      ],
      "properties": {
        "entry": {"$ref": "#/$defs/id"},
        "entry_name": {"type": "string"},
        "player_name": {"type": "string"},
        "rank": {"type": "integer", "minimum": 0},
        "rank_sort": {"type": "integer", "minimum": 1},
        "last_rank": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": "integer"},
        "matches_played": {"type": "integer", "minimum": 0},
        "matches_won": {"type": "integer", "minimum": 0},
        "matches_drawn": {"type": "integer", "minimum": 0},
        "matches_lost": {"type": "integer", "minimum": 0},
        "points_for": {"type": "integer"}
      }
    }
  }
}
