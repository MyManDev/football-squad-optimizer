{
  "$id": "https://squadopt.dev/contracts/weekly_suggestion_history_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contract_version": {
      "const": "weekly_suggestion_history_v1"
    },
    "generated_at_utc": {
      "pattern": "Z$",
      "type": "string"
    },
    "payload": {
      "properties": {
        "as_of_snapshot_id": {
          "minLength": 1,
          "type": "string"
        },
        "entry_id": {
          "minimum": 1,
          "type": "integer"
        },
        "league_id": {
          "const": 352490
        },
        "season": {
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "type": "string"
        },
        "weeks": {
          "items": {
            "properties": {
              "actual": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "properties": {
                      "gross_points": {
                        "type": "number"
                      },
                      "net_points": {
                        "type": "number"
                      },
                      "transfer_hit_points": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "gross_points",
                      "transfer_hit_points",
                      "net_points"
                    ],
                    "type": "object"
                  }
                ]
              },
              "actual_reason": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "advice_captured_at_utc": {
                "pattern": "Z$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "advice_generated_at_utc": {
                "pattern": "Z$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "advice_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "advice_snapshot_id": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "deadline_utc": {
                "pattern": "Z$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "expected_own_points": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "gameweek": {
                "minimum": 1,
                "type": "integer"
              },
              "net_difference": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "outcome_captured_at_utc": {
                "pattern": "Z$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "outcome_snapshot_id": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "players": {
                "items": {
                  "properties": {
                    "captain": {
                      "type": "boolean"
                    },
                    "counted_points": {
                      "type": "number"
                    },
                    "expected_points": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "forecast_error": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "minutes": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "multiplier": {
                      "maximum": 3,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "player_id": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "position": {
                      "enum": [
                        "GK",
                        "DEF",
                        "MID",
                        "FWD"
                      ]
                    },
                    "realized_points": {
                      "type": "number"
                    },
                    "role": {
                      "enum": [
                        "starter",
                        "bench"
                      ]
                    },
                    "vice_captain": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "player_id",
                    "name",
                    "position",
                    "role",
                    "captain",
                    "vice_captain",
                    "expected_points",
                    "realized_points",
                    "minutes",
                    "multiplier",
                    "counted_points",
                    "forecast_error"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "reason": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "recorded_plans": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "captain": {
                      "minLength": 1,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "chip": {
                      "enum": [
                        null,
                        "wildcard",
                        "freehit",
                        "bboost",
                        "3xc"
                      ]
                    },
                    "expected_points_cost": {
                      "type": "number"
                    },
                    "expected_points_cost_ceiling": {
                      "type": "number"
                    },
                    "managers_word": {
                      "const": true
                    },
                    "moves": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "player_in": {
                            "minLength": 1,
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "player_out": {
                            "minLength": 1,
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "player_out",
                          "player_in"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "published_path": {
                      "pattern": "^advice/[1-9][0-9]*/",
                      "type": "string"
                    },
                    "rival_entry_id": {
                      "minimum": 1,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "strategy": {
                      "enum": [
                        "saf-puan",
                        "ortak-koru",
                        "fark-yarat",
                        "garantici",
                        "agresif",
                        "asiri-agresif"
                      ]
                    },
                    "top100_weight": {
                      "enum": [
                        0,
                        5,
                        10,
                        20,
                        30,
                        40,
                        50
                      ]
                    },
                    "window": {
                      "enum": [
                        1,
                        3,
                        5
                      ]
                    }
                  },
                  "required": [
                    "published_path",
                    "strategy",
                    "window",
                    "rival_entry_id",
                    "chip",
                    "captain",
                    "moves"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "status": {
                "enum": [
                  "available",
                  "unsettled",
                  "unavailable"
                ]
              },
              "suggested": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "properties": {
                      "autosub_points": {
                        "type": "number"
                      },
                      "captain_bonus_points": {
                        "type": "number"
                      },
                      "chip": {
                        "enum": [
                          null,
                          "wildcard",
                          "freehit",
                          "bboost",
                          "3xc"
                        ]
                      },
                      "gross_points": {
                        "type": "number"
                      },
                      "net_points": {
                        "type": "number"
                      },
                      "transfer_hit_points": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "gross_points",
                      "transfer_hit_points",
                      "net_points",
                      "captain_bonus_points",
                      "autosub_points",
                      "chip"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": [
              "gameweek",
              "status",
              "reason",
              "actual_reason",
              "deadline_utc",
              "advice_captured_at_utc",
              "advice_generated_at_utc",
              "outcome_captured_at_utc",
              "advice_snapshot_id",
              "outcome_snapshot_id",
              "advice_sha256",
              "expected_own_points",
              "net_difference",
              "suggested",
              "actual",
              "players"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "league_id",
        "entry_id",
        "season",
        "as_of_snapshot_id",
        "weeks"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "generated_at_utc",
    "payload"
  ],
  "type": "object"
}
