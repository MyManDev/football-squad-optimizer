# Copy outside Git and replace every placeholder with existing host paths.
SQUADOPT_BACKEND_IMAGE=registry.example/squadopt-backend@sha256:REPLACE_WITH_TESTED_DIGEST
# Both published hostnames, canonical first: squadopt.mymandev.com is the address members
# open (the pages.dev name is SNI-filtered from Turkish networks); squadopt.pages.dev is
# the deployment-identity alias. Must match SITE_ORIGINS in platform/backend_runtime.py.
SQUADOPT_BACKEND_ALLOWED_ORIGINS=https://squadopt.mymandev.com,https://squadopt.pages.dev
SQUADOPT_STORE_PATH=/srv/squadopt/store
SQUADOPT_SITE_PATH=/srv/squadopt/site/data
SQUADOPT_SNAPSHOT_PATH=/srv/squadopt/snapshots
SQUADOPT_HANDOFF_PATH=/srv/squadopt/handoffs
# Optional, for a process run outside Compose (the Compose file does not mount these yet).
# Together they switch on the member menu's Top 100 settings and the manager's word; unset,
# a switched-on request is refused by name and plain requests are unchanged.
# The repository's artifacts/ directory: phase_b/ holds the Top 100 evidence exports,
# rotation/ the rotation tables, each beside its manifest.
# SQUADOPT_BACKEND_ARTIFACT_ROOT=/srv/squadopt/artifacts
# The club-news fixture file, or a club-news capture directory under the snapshot root.
# SQUADOPT_BACKEND_CLUB_NEWS_SOURCE=/srv/squadopt/club_news_v1.fixture.json
SQUADOPT_API_PORT=8000
SQUADOPT_WORKER_METRICS_PORT=9091
