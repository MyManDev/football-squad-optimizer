# One tick of the weekly schedule's deadline gate (#1243), started by weekly-schedule.timer.
# A definition, not applied by committing it: deploy/weekly-schedule/README.md says what the
# host needs and in which order to enable it. The paths assume the VM's layout (user squadopt,
# ~/squadopt); replace them where the host differs.
#
# A tick decides; at most once a UTC morning and once a gameweek it starts a weekly run and,
# with --release, releases a run that exits 0. That can take hours, so the tick has no start
# timeout, and while it runs the timer starts no second one.
[Unit]
Description=SquadOpt weekly schedule: one tick of the deadline gate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=squadopt
Group=squadopt
WorkingDirectory=/home/squadopt/squadopt/weekly
# Private, outside Git: SQUADOPT_CLUB_NEWS_SETTINGS and the model key variable the settings
# name. Never put a secret in this file.
EnvironmentFile=/etc/squadopt/weekly-schedule.env
Environment=PYTHONPATH=/home/squadopt/squadopt/weekly/src:/home/squadopt/squadopt/weekly
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/squadopt/squadopt/weekly/.venv/bin/python -m squadopt.platform.weekly_schedule --workspace /home/squadopt/squadopt/weekly --release
TimeoutStartSec=infinity
