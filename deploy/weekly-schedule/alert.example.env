# Copy to /etc/squadopt/alert.env (root, mode 0600) and fill it in; nothing here is real.
# README, "Backups and alerts", says where each value comes from.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=<the private topic both phones subscribe to>
# Only for a topic that needs a token:
# NTFY_TOKEN=<the topic's access token>
HC_WATCH_URL=<the healthchecks.io ping address of the five-minute check>
HC_BACKUP_URL=<the healthchecks.io ping address of the nightly backup>
