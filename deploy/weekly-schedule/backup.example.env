# Copy to /etc/squadopt/backup.env (root, mode 0600) and fill it in; nothing here is real.
# README, "Backups and alerts", says where each value comes from.
RESTIC_REPOSITORY=s3:https://<the R2 account id>.r2.cloudflarestorage.com/<the bucket>
RESTIC_PASSWORD_FILE=/etc/squadopt/restic-password
AWS_ACCESS_KEY_ID=<the R2 token's access key id>
AWS_SECRET_ACCESS_KEY=<the R2 token's secret access key>
AWS_DEFAULT_REGION=auto
